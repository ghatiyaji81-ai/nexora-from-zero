MONGODB_URI=mongodb://127.0.0.1:27017/nexora?replicaSet=rs0
APP_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT_SECRET=

# Password recovery sends through Resend. Leave unset until a verified sender is available.
RESEND_API_KEY=
EMAIL_FROM=

# THINK uses the OpenAI Responses API. Keep this secret on the server only.
OPENAI_API_KEY=
THINK_OPENAI_MODEL=gpt-4.1-mini
# Optional comma-separated list for the model selector.
THINK_OPENAI_MODELS=
# Research web search is opt-in and requires a model that supports the Responses API web_search tool.
THINK_ENABLE_WEB_SEARCH=false
# Optional OpenAI-compatible endpoint for a trusted server-side provider gateway.
THINK_OPENAI_BASE_URL=
